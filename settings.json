{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|Bash|Task|Agent|Workflow|NotebookEdit|mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/go-gate-pretool.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/fact-gate.py"
          }
        ]
      },
      {
        "matcher": "mcp__notion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/notion-guard.py",
            "timeout": 10,
            "statusMessage": "Verrou Notion couleurs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/client-deliverable-guard.py",
            "timeout": 15,
            "statusMessage": "Verrou livrable client"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/output-verifier.py",
            "timeout": 15,
            "statusMessage": "Verrou de sortie"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/relance-projet.py",
            "timeout": 10,
            "statusMessage": "Relance projet"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/ledger.py prompt"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/output-rules.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/go-gate-prompt.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/skill-activation.py"
          }
        ]
      }
    ]
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "voiceEnabled": true
}
